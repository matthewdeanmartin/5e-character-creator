# --- Stage 1: The Builder ---
FROM golang:1.22-alpine AS builder

WORKDIR /app

# Copy the Go module files and download dependencies
COPY go.mod ./

# Copy the rest of the source code
COPY . .

# Build the native Go backend executable for Linux
RUN CGO_ENABLED=0 GOOS=linux go build -o character-creator main.go

# --- Stage 2: The Production Image ---
FROM alpine:latest

WORKDIR /app

# Copy the compiled Go binary from the builder stage
COPY --from=builder /app/character-creator .

COPY public/ ./public/

# Expose port 8080 to the local machine
EXPOSE 8080

# Starts the Go web server
CMD ["./character-creator"]
